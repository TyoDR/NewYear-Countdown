<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    
    <title>New Year - Immersive Sky</title>
    <meta name="description" content="Saksikan hitung mundur live menuju Tahun Baru dengan pertunjukan kembang api virtual yang memukau!">
    
    <meta property="og:type" content="website">
    <meta property="og:title" content="Happy New Year - Live Countdown">
    <meta property="og:description" content="Rayakan pergantian tahun dengan kembang api virtual interaktif di layarmu.">
    <meta property="og:image" content="https://images.unsplash.com/photo-1467810563316-b5476525c0f9?q=80&w=1000&auto=format&fit=crop">
    
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Happy New Year - Live Countdown">
    <meta name="twitter:description" content="Rayakan pergantian tahun dengan kembang api virtual interaktif di layarmu.">
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;900&display=swap');
        
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        /* FIX LAYAR PENUH (Mobile) */
        html { height: 100%; }
        body { 
            width: 100%; 
            min-height: 100%;
            height: 100dvh; /* Dynamic Height agar pas di browser HP */
            overflow: hidden; 
            touch-action: none; /* Mencegah zoom/scroll */
            -webkit-user-select: none; user-select: none; 
            -webkit-tap-highlight-color: transparent;
            position: relative;
            background: #000; color: #fff; font-family: 'Montserrat', sans-serif;
            display: flex; justify-content: center; align-items: center;
            
            /* Gradasi Langit Malam Deep Space */
            background: radial-gradient(circle at center bottom, #1b2735 0%, #090a0f 100%);
        }
        
        /* CANVAS (Langit & Kembang Api) */
        /* Z-Index 1: Di belakang teks */
        #canvas-stage { 
            position: absolute; top: 0; left: 0; width: 100%; height: 100%; 
            z-index: 1; 
        }

        /* --- UI CONTAINER (TRANSPARAN) --- */
        .ui-container {
            position: relative; 
            z-index: 10; /* Di atas canvas */
            text-align: center;
            width: 90%; max-width: 600px;
            
            /* TRANSPARAN TOTAL: Tidak ada background */
            background: transparent;
            pointer-events: none; /* Sentuhan tembus ke canvas */
        }

        /* --- TYPOGRAPHY --- */
        .timer-flex { 
            display: flex; gap: 15px; justify-content: center; margin-top: 1rem; 
        }
        
        .time-unit { 
            display: flex; flex-direction: column; align-items: center; width: 70px; 
        }
        
        /* Label "MENUJU..." */
        #label-target {
            letter-spacing: 4px; font-weight: 400; opacity: 0.9; font-size: 1.1rem;
            text-shadow: 0 2px 10px rgba(0,0,0,1); /* Shadow hitam pekat */
        }

        /* Angka Hitungan */
        .number-box {
            font-size: 3rem; font-weight: 900;
            background: linear-gradient(135deg, #fff 30%, #ffd700 70%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            /* Filter Drop Shadow (Penting agar teks gradient terbaca jelas) */
            filter: drop-shadow(0 4px 5px rgba(0,0,0,0.9));
        }
        
        /* Efek Berdenyut Merah di 10 Detik Terakhir */
        .number-box.urgent { 
            color: #ff0055; -webkit-text-fill-color: #ff0055; 
            animation: pulse 0.5s infinite alternate; 
            filter: drop-shadow(0 0 10px rgba(255, 0, 85, 0.8));
        }
        
        /* Label Kecil (Hari, Jam, Menit) */
        .label-bottom { 
            font-size: 0.7rem; text-transform: uppercase; margin-top: 5px; opacity: 0.9; 
            text-shadow: 0 2px 4px rgba(0,0,0,1);
            font-weight: 700;
        }
        
        /* Pesan Hint Bawah */
        .message-hint {
            margin-top: 40px; font-size: 0.75rem; opacity: 0.7;
            text-shadow: 0 2px 8px rgba(0,0,0,1);
            animation: pulse 2s infinite;
        }

        /* --- PANEL PERAYAAN --- */
        #celebration-panel { display: none; flex-direction: column; align-items: center; }
        
        .main-title {
            font-size: 4rem; font-weight: 900; line-height: 1.1; margin-bottom: 10px;
            background: linear-gradient(to right, #bf953f, #fcf6ba, #aa771c);
            background-size: 200%; -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            animation: shine 3s linear infinite;
            /* Shadow super tebal untuk judul utama */
            filter: drop-shadow(0 0 25px rgba(0,0,0,1)); 
        }
        
        .sub-title { 
            font-size: 1.3rem; letter-spacing: 4px; color: #fcf6ba; text-transform: uppercase; 
            text-shadow: 0 4px 10px rgba(0,0,0,1); 
            font-weight: 700;
        }

        /* Animasi */
        @keyframes shine { to { background-position: 200% center; } }
        @keyframes pulse { 0% { transform: scale(1); opacity: 0.7; } 50% { transform: scale(1.05); opacity: 1; } 100% { transform: scale(1); opacity: 0.7; } }

        /* Responsif HP Kecil */
        @media (max-width: 400px) {
            .main-title { font-size: 3rem; }
            .number-box { font-size: 2.2rem; }
            .time-unit { width: 55px; }
            .timer-flex { gap: 8px; }
        }
    </style>
</head>
<body>

    <audio id="bg-music" loop>
        <source src="https://commondatastorage.googleapis.com/codeskulptor-demos/riceracer_assets/music/win.ogg" type="audio/ogg">
    </audio>

    <canvas id="canvas-stage"></canvas>
    
    <div class="ui-container" id="main-ui">
        <div id="countdown-panel">
            <h2 id="label-target">MENUJU...</h2>
            
            <div class="timer-flex">
                <div class="time-unit"><div class="number-box" id="d">00</div><div class="label-bottom">Hari</div></div>
                <div class="time-unit"><div class="number-box" id="h">00</div><div class="label-bottom">Jam</div></div>
                <div class="time-unit"><div class="number-box" id="m">00</div><div class="label-bottom">Menit</div></div>
                <div class="time-unit"><div class="number-box" id="s">00</div><div class="label-bottom">Detik</div></div>
            </div>
            <p class="message-hint">COUNTDOWN NEW YEAR</p>
        </div>

        <div id="celebration-panel">
            <h1 class="main-title">HAPPY<br>NEW YEAR</h1>
            <p class="sub-title" id="label-year-new">20XX</p> 
            <p class="message-hint">Created by TyoDR</p>
        </div>
    </div>

    <script>
        // ==========================================
        // 1. SETUP TAHUN OTOMATIS (ABADI)
        // ==========================================
        const now = new Date();
        const currentYear = now.getFullYear();
        let targetYear = currentYear + 1; 
        
        // Jika sekarang tgl 1 Januari, target tetap tahun ini (mode perayaan 24 jam)
        if (now.getMonth() === 0 && now.getDate() === 1) targetYear = currentYear;

        const countDate = new Date(`Jan 1, ${targetYear} 00:00:00`).getTime();
        
        // Update Teks Label
        document.getElementById('label-target').innerText = `MENUJU ${targetYear}`;
        document.getElementById('label-year-new').innerText = `LEMBARAN BARU ${targetYear}`;

        // ==========================================
        // 2. AUDIO ENGINE (Synthesizer & Music)
        // ==========================================
        let audioCtx;
        let isAudioEnabled = false;
        const bgMusic = document.getElementById('bg-music');
        
        // Fungsi Unlock Audio (Browser Policy)
        function enableAudio() {
            if (isAudioEnabled) return; 
            try {
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                audioCtx = new AudioContext();
                audioCtx.resume();
                isAudioEnabled = true;
                bgMusic.volume = 0.6;
                bgMusic.play().then(() => {
                    // Jika belum tahun baru, pause musiknya
                    if (appState === 'counting') { bgMusic.pause(); bgMusic.currentTime = 0; }
                }).catch(() => {});
            } catch (e) { console.log(e); }
        }

        // Fungsi Suara Ledakan Sintetis (Boom Effect)
        function playExplosionSound() {
            if (!audioCtx || !isAudioEnabled) return;
            const t = audioCtx.currentTime;
            
            // Buat Noise
            const buffer = audioCtx.createBuffer(1, audioCtx.sampleRate * 2, audioCtx.sampleRate);
            const data = buffer.getChannelData(0);
            for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;
            
            const noise = audioCtx.createBufferSource(); 
            noise.buffer = buffer;
            
            // Filter Lowpass (Biar ngebass)
            const filter = audioCtx.createBiquadFilter(); 
            filter.type = 'lowpass';
            filter.frequency.setValueAtTime(1000, t); 
            filter.frequency.exponentialRampToValueAtTime(100, t + 1);
            
            // Gain (Fade out)
            const gain = audioCtx.createGain(); 
            gain.gain.setValueAtTime(1, t); 
            gain.gain.exponentialRampToValueAtTime(0.01, t + 1.5);
            
            noise.connect(filter); 
            filter.connect(gain); 
            gain.connect(audioCtx.destination);
            
            noise.start(); 
            noise.stop(t + 2);
        }

        // ==========================================
        // 3. LOGIKA HITUNG MUNDUR (REAL-TIME)
        // ==========================================
        let appState = 'counting'; 
        let timerInterval;

        function updateTimer() {
            const currentTime = new Date().getTime();
            const distance = countDate - currentTime;

            if (distance <= 0) {
                triggerCelebration();
                return;
            }

            const d = Math.floor(distance / (1000 * 60 * 60 * 24));
            const h = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const m = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const s = Math.floor((distance % (1000 * 60)) / 1000);

            document.getElementById('d').innerText = d < 10 ? '0'+d : d;
            document.getElementById('h').innerText = h < 10 ? '0'+h : h;
            document.getElementById('m').innerText = m < 10 ? '0'+m : m;
            
            const sEl = document.getElementById('s');
            sEl.innerText = s < 10 ? '0'+s : s;

            // Merah jika < 10 detik
            if (d === 0 && h === 0 && m === 0 && s <= 10) sEl.classList.add('urgent');
            else sEl.classList.remove('urgent');
        }

        timerInterval = setInterval(updateTimer, 1000);
        updateTimer();

        function triggerCelebration() {
            clearInterval(timerInterval);
            if (appState === 'celebrating') return;
            appState = 'celebrating';
            
            document.getElementById('countdown-panel').style.display = 'none';
            document.getElementById('celebration-panel').style.display = 'flex';
            
            // Nyalakan Audio & Kembang Api
            if (isAudioEnabled) { bgMusic.play().catch(()=>{}); playExplosionSound(); }
            fireworkChance = 0.2; // Tambah intensitas
        }

        // ==========================================
        // 4. VISUAL ENGINE (CANVAS)
        // ==========================================
        const canvas = document.getElementById('canvas-stage');
        const ctx = canvas.getContext('2d', { alpha: false });
        let w, h;
        
        const resize = () => { w = canvas.width = window.innerWidth; h = canvas.height = window.innerHeight; };
        window.addEventListener('resize', resize); resize();

        const colors = ['255,215,0', '0,255,255', '255,0,255', '50,255,50', '255,100,100'];
        let fireworks = [], particles = [], stars = [];
        let fireworkChance = 0.0; 
        const random = (min, max) => Math.random() * (max - min) + min;

        // --- Class Bintang (FULL SCREEN SCATTER) ---
        class Star {
            constructor() {
                this.x = Math.random() * w;
                this.y = Math.random() * h; // Muncul di seluruh layar
                this.size = Math.random() * 2;
                this.opacity = Math.random();
                this.speed = Math.random() * 0.05;
            }
            update() {
                this.opacity += this.speed;
                if(this.opacity > 1 || this.opacity < 0) this.speed = -this.speed;
            }
            draw() {
                ctx.fillStyle = `rgba(255, 255, 255, ${this.opacity})`;
                ctx.beginPath(); ctx.arc(this.x, this.y, this.size, 0, Math.PI*2); ctx.fill();
            }
        }
        // Buat 200 bintang
        for(let i=0; i<200; i++) stars.push(new Star());

        // --- Class Firework ---
        class Firework {
            constructor() {
                this.x = random(w*0.1, w*0.9); 
                this.y = h; 
                this.targetY = random(h*0.1, h*0.8); // Meledak bebas dari atas sampai bawah
                this.vx = Math.cos(-Math.PI/2 + random(-0.3,0.3)) * random(4,10);
                this.vy = Math.sin(-Math.PI/2 + random(-0.3,0.3)) * random(4,10);
                this.hue = colors[Math.floor(random(0, colors.length))];
                this.dead = false;
            }
            update() {
                this.x += this.vx; this.y += this.vy; this.vy += 0.15; 
                if(this.vy >= 0 || this.y < this.targetY) { this.dead = true; explode(this.x, this.y, this.hue); }
            }
            draw() {
                ctx.beginPath(); ctx.moveTo(this.x, this.y); ctx.lineTo(this.x - this.vx*2, this.y - this.vy*2);
                ctx.strokeStyle = `rgb(${this.hue})`; ctx.lineWidth = 2; ctx.stroke();
            }
        }

        // --- Class Particle ---
        class Particle {
            constructor(x, y, hue) {
                this.x = x; this.y = y; this.hue = hue;
                const a = random(0, Math.PI*2), s = random(1, 8);
                this.vx = Math.cos(a)*s; this.vy = Math.sin(a)*s;
                this.alpha = 1; this.decay = random(0.015, 0.03);
            }
            update() {
                this.vx *= 0.92; this.vy *= 0.92; this.vy += 0.08;
                this.x += this.vx; this.y += this.vy; this.alpha -= this.decay;
            }
            draw() {
                ctx.beginPath(); ctx.arc(this.x, this.y, 2, 0, Math.PI*2);
                ctx.fillStyle = `rgba(${this.hue}, ${this.alpha})`; ctx.fill();
            }
        }

        function explode(x, y, hue) {
            for(let i=0; i<80; i++) particles.push(new Particle(x, y, hue));
            if(appState === 'celebrating') playExplosionSound();
        }

        // --- Shooting Star Logic ---
        function createShootingStar() {
            if (Math.random() < 0.02) { // Peluang 2% per frame
                particles.push({
                    x: random(0, w), y: 0, 
                    vx: random(-5, 5), vy: random(5, 10),
                    alpha: 1, decay: 0.02, hue: '255,255,255',
                    update: function(){ this.x+=this.vx; this.y+=this.vy; this.alpha-=this.decay; },
                    draw: function(){ 
                        ctx.beginPath(); ctx.moveTo(this.x, this.y); ctx.lineTo(this.x-this.vx*3, this.y-this.vy*3);
                        ctx.strokeStyle=`rgba(255,255,255,${this.alpha})`; ctx.lineWidth=2; ctx.stroke();
                    }
                });
            }
        }

        // --- ANIMATION LOOP ---
        function animate() {
            ctx.clearRect(0,0,w,h); // Bersihkan layar total (Transparan)
            
            // Gambar Bintang
            stars.forEach(star => { star.update(); star.draw(); });
            createShootingStar();

            // Kembang Api
            if(appState === 'celebrating' && Math.random() < fireworkChance) fireworks.push(new Firework());
            
            fireworks.forEach((f,i) => { f.update(); f.draw(); if(f.dead) fireworks.splice(i,1); });
            particles.forEach((p,i) => { p.update(); p.draw(); if(p.alpha<=0) particles.splice(i,1); });
            
            requestAnimationFrame(animate);
        }
        animate();

        // ==========================================
        // 5. INTERAKSI TOUCH (FULL SCREEN)
        // ==========================================
        function handleTouch(e) {
            enableAudio(); // Unlock audio saat sentuh pertama
            if(appState !== 'celebrating') return;
            
            let x, y;
            if(e.type.includes('touch')) { x = e.changedTouches[0].clientX; y = e.changedTouches[0].clientY; }
            else { x = e.clientX; y = e.clientY; }
            
            explode(x, y, colors[Math.floor(Math.random()*colors.length)]);
        }

        document.addEventListener('mousedown', handleTouch);
        document.addEventListener('touchstart', handleTouch, { passive: false });

    </script>
</body>
</html>
